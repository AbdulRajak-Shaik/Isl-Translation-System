yarn-error.log*

# Datasets and Media (Critical Compliance: Never commit raw video or private datasets)
data/raw/*
!data/raw/.gitkeep
data/extracted_frames/*
!data/extracted_frames/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/scratch/*
!data/scratch/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.tar.gz
*.zip
*.h5

# Model Checkpoints and Weights
*.pt
*.pth
*.bin
*.onnx
*.safetensors
ml/checkpoints/*
!ml/checkpoints/.gitkeep
!ml/checkpoints/isl_transformer_best.pt
!isl_transformer_best.pt

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
