# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model & Inference Configuration
MODEL_CHECKPOINT_PATH=ml/checkpoints/isl_transformer_best.pt
MODEL_DEVICE=cpu
MAX_SEQUENCE_LENGTH=150
FRAME_SAMPLE_RATE=2
CONFIDENCE_THRESHOLD=0.60
UNCERTAINTY_ENTROPY_THRESHOLD=1.85

# Translation Services
TRANSLATION_BACKEND=indictrans2
INDICTRANS2_MODEL_NAME=ai4bharat/indictrans2-en-indic-dist-200M
USE_GPU_FOR_TRANSLATION=false

# Text-to-Speech Services
TTS_ENGINE=gtts
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
EDGE_TTS_VOICE_TE=te-IN-ShrutiNeural

# Upload & Storage Privacy Settings
UPLOAD_TEMP_DIR=data/scratch/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=180
AUTO_DELETE_PROCESSED_VIDEOS=true
